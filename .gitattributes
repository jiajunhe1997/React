# Normalize text in Git; use LF on checkout across platforms.
* text=auto
*.swift text eol=lf
*.pbxproj text eol=lf
*.xcscheme text eol=lf
*.xcworkspacedata text eol=lf
*.xcstrings text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.mp3 binary
*.wav binary
