    "Access your pictures from the keyboard! Enable full access for the React Keyboard in Settings > General > Keyboard > Keyboards > React Keyboard > Allow Full Access." : {
      "extractionState" : "manual",
      "localizations" : {
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कीबोर्ड से अपनी फ़ोटो इस्तेमाल करें! सेटिंग > सामान्य > कीबोर्ड > कीबोर्ड > React Keyboard में पूर्ण ऐक्सेस की अनुमति दें।"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accédez à vos photos depuis le clavier ! Dans Réglages > Général > Clavier > Claviers > React Keyboard, activez « Autoriser l’accès complet »."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accede a tus fotos desde el teclado. En Ajustes > General > Teclado > Teclados > React Keyboard, activa «Permitir acceso total»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーボードから写真を使えます。「設定」＞「一般」＞「キーボード」＞「キーボード」＞「React Keyboard」で「フルアクセスを許可」をオンにしてください。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akses foto dari papan ketik! Di Pengaturan > Umum > Papan Ketik > Papan Ketik > React Keyboard, aktifkan Izinkan Akses Penuh."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accede a tus fotos desde el teclado. En Ajustes > General > Teclado > Teclados > React Keyboard, activa «Permitir acceso total»."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Access your pictures from the keyboard! Enable full access for the React Keyboard in Settings > General > Keyboard > Keyboards > React Keyboard > Allow Full Access."
          }
        }
      }
    },
